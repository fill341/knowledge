#!/usr/bin/env bash
# kn-mcp-launch <agent> <profile> [extra kn-mcp args]
#
# Starts kn-mcp with the token of principal <agent>@<profile> taken from the macOS Keychain,
# so tokens never live in tool configs (.mcp.json, config.toml, ...).
#
#   claude mcp add knowledge --scope user -- /path/to/knowledge/scripts/kn-mcp-launch claude-code personal
set -euo pipefail

if [ $# -lt 2 ]; then
  echo "usage: kn-mcp-launch <agent> <profile>" >&2
  exit 2
fi
agent="$1"; profile="$2"; shift 2

here="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
bin="$(command -v kn-mcp || true)"
if [ -z "$bin" ] && [ -x "$here/bin/kn-mcp" ]; then bin="$here/bin/kn-mcp"; fi
if [ -z "$bin" ]; then
  echo "kn-mcp not found: run 'make install' or 'make build' in $here" >&2
  exit 1
fi

export KN_API_URL="${KN_API_URL:-http://127.0.0.1:8787}"
export KN_AGENT="$agent"
if [ -z "${KN_TOKEN:-}" ]; then
  if ! KN_TOKEN="$(security find-generic-password -s kn-token -a "${agent}@${profile}" -w 2>/dev/null)"; then
    echo "no token for ${agent}@${profile} in Keychain: run 'make token PRINCIPAL=${agent}@${profile} SCOPES=...'" >&2
    exit 1
  fi
  export KN_TOKEN
fi
exec "$bin" "$@"
