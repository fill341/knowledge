# Copy to deploy/.env to override defaults. No secrets here — they live in deploy/secrets/.
KN_API_PORT=8787
KN_PG_PORT=5433
KN_MCP_PORT=8788
KN_LOG_LEVEL=info
KN_AUDIT_READS=false
# Point this at an external disk or a Time Machine-covered folder
KN_BACKUP_DIR=./backups
BACKUP_INTERVAL_SECONDS=86400
BACKUP_KEEP=14
